// SwitchMate — Firestore security rules (staff/participant portal)
// Paste this into Firebase Console → Firestore → Rules, then Publish.
//
// Model:
//   staff/{uid}            — approved staff members (admin writes these)
//   staff_requests/{uid}   — pending access requests (self-written)
//   clients/{clientId}     — participant records (staff-writable)
//   sessions/{sessionId}   — activity sessions + billing/narrative metrics
//
// IMPORTANT: until these rules are published, the existing collections
// (switchmate_analytics, messages, game_maker_events) remain open. Lock
// those too when you deploy.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- staff registry (write by admin/service account only) ----
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // no client-side writes; manage in console
    }

    // ---- access requests ----
    match /staff_requests/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
    }

    // ---- participant records ----
    match /clients/{clientId} {
      allow read, write: if signedIn()
        && (resource == null
            || request.auth.uid in resource.data.staffIds
            || request.auth.uid in request.resource.data.staffIds);
    }

    // ---- activity sessions ----
    match /sessions/{sessionId} {
      // staff can read their own sessions; anyone with a participant link
      // (i.e. a session that has a participantToken) can read that session.
      allow get: if (signedIn() && request.auth.uid in resource.data.staffIds)
                  || resource.data.participantToken != null;
      allow list: if signedIn() && request.auth.uid in resource.data.staffIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.staffIds;
      allow update: if signedIn() && request.auth.uid in resource.data.staffIds;
      allow delete: if false;

      // participant progress log (append-only, no auth — capability-gated
      // by the unguessable session id revealed via the invite link)
      match /participant_log/{logId} {
        allow get, list: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // ---- participant invite links (capability URLs) ----
    match /links/{token} {
      allow get: if true;      // resolve token -> session id
      allow list: if false;
      allow write: if false;
    }

    // ---- existing SwitchMate public collections (anonymous writes) ----
    // Keep as-is until you decide to tighten them:
    match /switchmate_analytics/{doc} {
      allow read: if false;
      allow write: if true;
    }
    match /game_maker_events/{doc} {
      allow read: if false;
      allow write: if true;
    }
    match /messages/{doc} {
      allow read: if false;
      allow create: if true;
    }
    match /users/{doc} {
      allow read, write: if signedIn() && request.auth.uid == doc;
    }
  }
}
